{
  "name": "@xywen97/dsh-sidechat",
  "version": "0.1.0",
  "private": false,
  "description": "DSH 侧边聊天：在右侧栏开一个临时对话面板，自动把主对话历史作为隐藏上下文注入（不出现在聊天记录里），关掉即归档。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "side-chat",
    "sidebar",
    "temporary",
    "context",
    "chat",
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "author": "xywen97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xywen97/dsh-sidechat.git"
  },
  "homepage": "https://github.com/xywen97/dsh-sidechat#readme",
  "bugs": {
    "url": "https://github.com/xywen97/dsh-sidechat/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  }
}
